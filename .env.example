# Scorpius Move — env example (copy to .env; never commit real keys)

EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google Maps Platform — restrict by bundleId local.scorpius.move / package SHA-1
# Enable: Maps SDK for iOS, Maps SDK for Android (Maps JS optional for Expo Web)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
